# Desarrollo local de la API (npm run dev)
# ── Base de datos: Supabase (proyecto Zulycell, us-west-2) ──
# App: pooler de transacciones (6543). Migraciones: pooler de sesión (5432).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1

# ── Supabase Auth y Storage ──
SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clave secreta (Settings → API Keys → Secret keys). Necesaria para subir imágenes. NUNCA en el navegador.
SUPABASE_SECRET_KEY=sb_secret_...
STORAGE_PUBLIC_BUCKET=zulycell-public
STORAGE_PRIVATE_BUCKET=zulycell-private

# ── Aplicación ──
# Sesión propia de la API: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:3000
# true cuando se sirve por HTTPS (Netlify)
COOKIE_SECURE=false

# ── Opcional ──
# SMTP para enviar facturas por email (los correos de verificación los envía Supabase)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Zulycell <no-reply@zulycell.com>
# WhatsApp: "log" solo escribe en el log; "http" hace POST a WHATSAPP_API_URL
WHATSAPP_PROVIDER=log
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
