{
  "name": "@zulycell/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:local": "tsc -p tsconfig.json && node --env-file=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "2.45.6",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "express": "5.0.1",
    "helmet": "8.0.0",
    "jose": "5.9.6",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "nodemailer": "6.9.16",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "serverless-http": "3.2.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.7",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "22.8.1",
    "@types/nodemailer": "6.4.16",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
